{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bastet-targets",
  "account_id": "b6d1478423f0bb0c0477df387305e46b",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "targets.bastet.ai",
      "custom_domain": true,
      "zone_id": "048469a55c190930b5bf4105307aad2b"
    }
  ],
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
